# Base de datos (local sin Docker)
DATABASE_URL=postgresql+asyncpg://conversa:conversa@localhost:5432/conversa
REDIS_URL=redis://localhost:6379/0

# Webhook saliente hacia n8n (producción)
N8N_WEBHOOK_URL=

# Misma clave en nodos HTTP de n8n (header X-N8N-API-Key)
N8N_API_KEY=conversa-n8n-local-2026

# URL pública del backend (localtunnel / ngrok) — referencia
PUBLIC_API_URL=https://tu-subdominio.loca.lt

# YCloud - outbound WhatsApp (misma credencial "Ycloud key" de tu workflow)
YCLOUD_API_KEY=tu-api-key-ycloud
YCLOUD_FROM_NUMBER=

# Secreto para validar webhooks de YCloud (opcional)
YCLOUD_WEBHOOK_SECRET=

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sesión del panel. Los usuarios se crean al arrancar si todavía no existen.
JWT_SECRET=cambiar-este-secreto
JWT_EXPIRE_MINUTES=720
ADMIN_EMAIL=admin@circulo.local
ADMIN_PASSWORD=cambiar-admin
ADMIN_NAME=Administración
CONSEJO_EMAIL=consejo@circulo.local
CONSEJO_PASSWORD=cambiar-consejo
CONSEJO_NAME=Consejo

# Asistente interno. deepseek-chat es el modelo general; deepseek-reasoner es el de razonamiento.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Correo. Sin SMTP_HOST el formulario avisa que falta configurarlo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

